meta {
  name: Get user
  type: http
  seq: 1
  tags: [
    users
    smoke
  ]
}

get {
  url: {{baseUrl}}/users/:id?include=profile
  body: none
  auth: bearer
}

params:path {
  id: 123
}

params:query {
  include: profile
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Fetches one user and their optional profile.
}

example {
  name: user found 200
  description: A saved user response.

  request: {
    url: {{baseUrl}}/users/123
    method: GET
    mode: none
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": 123,
          "name": "Ada"
        }
      '''
    }
  }
}
