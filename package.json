{
  "name": "@dmpv/bruno-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP server and indexer for Bruno API collections.",
  "type": "module",
  "bin": {
    "bruno-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run pack:check",
    "dev": "tsx src/cli.ts serve",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "bruno",
    "mcp",
    "model-context-protocol",
    "api",
    "developer-tools"
  ],
  "author": "TheDMPV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheDMPV/bruno-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TheDMPV/bruno-mcp/issues"
  },
  "homepage": "https://github.com/TheDMPV/bruno-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@usebruno/filestore": "^0.11.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "nanoid": "3.3.8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
